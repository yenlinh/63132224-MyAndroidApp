<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgdangnhap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="📚 Tủ Truyện"
            android:textColor="#333333"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đăng nhập để tiếp tục"
            android:textColor="#777777"
            android:textSize="15sp" />

        <!-- Tài khoản -->
        <EditText
            android:id="@+id/taikhoan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/dn_edt"
            android:drawableEnd="@drawable/ic_taikhoan"
            android:drawablePadding="10dp"
            android:hint="Tài khoản"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColorHint="#888888" />

        <!-- Mật khẩu -->
        <EditText
            android:id="@+id/matkhau"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dn_edt"
            android:drawableEnd="@drawable/ic_matkhau"
            android:drawablePadding="10dp"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColorHint="#888888" />

        <!-- Đăng nhập -->
        <Button
            android:id="@+id/dangnhap"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#6C63FF"
            android:text="Đăng Nhập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Đăng ký -->
        <Button
            android:id="@+id/dangky"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E8EAF6"
            android:text="Tạo Tài Khoản Mới"
            android:textAllCaps="false"
            android:textColor="#6C63FF"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>