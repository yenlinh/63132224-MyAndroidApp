<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bgdoctruyen"
    android:padding="12dp"
    tools:context=".ManNoiDung">

    <!-- Nút quay lại -->
    <Button
        android:id="@+id/buttonQuayLai"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="←"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:backgroundTint="#FFFFFF"
        app:cornerRadius="24dp" />

    <!-- Tên truyện -->
    <TextView
        android:id="@+id/TenTruyen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="Tên Truyện"
        android:textColor="#333333"
        android:textSize="28sp" />

    <!-- Điều khiển đọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonDocTruyen"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#6C63FF"
            android:text="🔊 Đọc"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/buttonDung"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:backgroundTint="#FF7043"
            android:text="⏹ Dừng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Khung nội dung -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:layout_marginBottom="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/noidung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Nội dung truyện..."
                android:textColor="#444444"
                android:textSize="18sp"
                android:lineSpacingExtra="10dp"
                android:fontFamily="@font/quicksand"
                android:background="#FFFDF8"/>

        </ScrollView>

    </androidx.cardview.widget.CardView>

</LinearLayout>