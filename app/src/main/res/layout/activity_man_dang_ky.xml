<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgdangnhap"
    tools:context=".ManDangKy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo / Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="📚 Đăng Ký"
            android:textColor="#333333"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tạo tài khoản để tham gia Tủ Truyện"
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- Tài khoản -->
        <EditText
            android:id="@+id/dktaikhoan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/dn_edt"
            android:drawableEnd="@drawable/ic_taikhoan"
            android:drawablePadding="10dp"
            android:fontFamily="@font/quicksand"
            android:hint="Tài khoản"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColorHint="#888888" />

        <!-- Mật khẩu -->
        <EditText
            android:id="@+id/dkmatkhau"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dn_edt"
            android:drawableEnd="@drawable/ic_matkhau"
            android:drawablePadding="10dp"
            android:fontFamily="@font/quicksand"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColorHint="#888888" />

        <!-- Email -->
        <EditText
            android:id="@+id/dkemail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/dn_edt"
            android:drawableEnd="@drawable/ic_email"
            android:drawablePadding="10dp"
            android:fontFamily="@font/quicksand"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textColorHint="#888888" />

        <!-- Nút đăng ký -->
        <Button
            android:id="@+id/dkdangky"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#6C63FF"
            android:text="Đăng Ký"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Nút trở về -->
        <Button
            android:id="@+id/dkdangnhap"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E8EAF6"
            android:text="Trở Về Đăng Nhập"
            android:textAllCaps="false"
            android:textColor="#6C63FF"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>